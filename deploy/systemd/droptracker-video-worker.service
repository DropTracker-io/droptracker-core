[Unit]
Description=DropTracker Video Processing Worker
After=network.target

[Service]
Environment=PYTHONUNBUFFERED=1
User=user
WorkingDirectory=/store/droptracker/disc
ExecStart=/store/droptracker/disc/venv/bin/python -u -m services.video_worker
Restart=always
RestartSec=5
TimeoutStopSec=30
Type=simple
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/store/droptracker
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
