# Nightly trigger for droptracker-stat-snapshots.service.
#
# Install:  sudo cp deploy/systemd/droptracker-stat-snapshots.{service,timer} /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now droptracker-stat-snapshots.timer

[Unit]
Description=Nightly DropTracker player stat snapshot retention

[Timer]
OnCalendar=*-*-* 05:20:00 UTC
RandomizedDelaySec=600
Persistent=true
Unit=droptracker-stat-snapshots.service

[Install]
WantedBy=timers.target
