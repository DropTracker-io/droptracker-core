[Unit]
# A human-readable description of the service
Description=DropTracker Core Discord Bot

# Start this service only after the network is available
After=network.target

[Service]
# The user that will run the application
User=user

# The working directory for the script
WorkingDirectory=/store/droptracker/disc

# The command to start the application.
# It's best practice to use the full path to the Python executable from your virtual environment.
ExecStart=/store/droptracker/disc/venv/bin/python -u -m bots.main

# Automatically restart the service if it fails
Restart=always
# Wait 5 seconds before restarting (systemd rejects inline comments on
# directive lines — an inline comment here silently reverts to the 100ms default)
RestartSec=5s

# Graceful shutdown timeout
TimeoutStopSec=30s

# Systemd watchdog configuration
Type=notify
NotifyAccess=all
WatchdogSec=30

# Environment variables
Environment=WATCHDOG_USEC=30000000

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/store/droptracker

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# CPU scheduling priority.
#
# The Discord gateway heartbeat is tiny but latency-critical: if this process
# cannot be scheduled for ~41s, Discord declares the connection zombied and
# forces a full reconnect. The bot only uses ~9% of one core, so it loses that
# race purely on scheduling, never on throughput.
#
# On 2026-08-20 a runaway `grep -rn <id> /` in an interactive session took 6 of
# 8 cores for 4+ hours; gateway reconnects went from ~0.8/hr to ~3.2/hr and one
# stall ran 3.5 minutes. CPUWeight raises this service's share of system.slice
# under contention (it is a weight, not a cap — an idle box is unaffected);
# user.slice is symmetrically deprioritised in its own drop-in.
CPUWeight=400
Nice=-5

[Install]
# Defines which system state should enable this service
WantedBy=multi-user.target


