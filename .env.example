STATE="dev" ## "dev", "live", "debug"

## NITRO BOOST ROLES -- LIVE SERVER
## Master switch for the Nitro-boost → group-credit reconciler on the webhook
## bot (case-insensitive). When on, members boosting PRIMARY_GUILD are turned
## into subscription-pool credit for their group. See services/nitro_attribution.py.
PROCESS_NITRO_BOOSTS = True
PRIMARY_GUILD_ID = 1172737525069135962
PRIMARY_GUILD_NITRO_ROLE_ID = 1172737525069135962
## Monthly pool credit (cents) granted per boosting member. Default 500 = $5.
NITRO_BOOST_CENTS = 500
## How often the reconciler recomputes per-group boost credit (minutes; min 5).
NITRO_RECONCILE_MINUTES = 60
## How long a reconciled nitro credit leg stays live without a refresh (hours).
## Must exceed the reconcile interval; the pool adds a further 72h grace.
NITRO_LEG_TTL_HOURS = 36

## Target webhook guilds 
## This is a list of guilds that contain webhooks which are used when updating our GitHub repository's url list
## Which, in turn, is loaded by players who have the API disabled. 
# The webhook processor bot then processes messages from these guilds to determine if they are 'submissions'

TARGET_GUILDS = ["123","456","789"]

## Reaction Roles -- LIVE SERVER
SHOULD_PROCESS_REACTIONS=False
DISCORD_MESSAGE_REACTION_ROLE_MESSAGE_ID=0
DISCORD_MESSAGE_REACTION_ROLE_EMOJI_ID=0
DISCORD_MESSAGE_REACTION_ROLE_ROLE_ID=0

## Database credentials
DB_USER=root
DB_PASS=root
WOM_API_KEY=
## Optional WOM tuning (defaults shown). These apply to a single shared,
## Redis-backed budget across ALL processes (API workers, bot, scripts) --
## they are not per-process.
# WOM_RATE_LIMIT_REQUESTS=100
# WOM_RATE_LIMIT_PERIOD_SECONDS=65
# WOM_RATE_LIMIT_MAX_WAIT_SECONDS=15   ## beyond this backlog, calls fail fast instead of queueing
# WOM_PLAYER_CACHE_TTL=900
# WOM_PLAYER_FAIL_CACHE_TTL=300
# WOM_GROUP_CACHE_TTL=900
## Events: WOM reconciliation (services/event_wom_reconciler.py, defaults shown)
# WOM_RECONCILE_SECONDS=300          ## bulk-gains poll cadence during active events
# WOM_BULK_CACHE_TTL=240             ## bulk response cache; keep BELOW the poll cadence
# WOM_EVENT_UPDATE_BUDGET=10         ## per-player updates in the activation pass
# WOM_UPDATE_ALL_LEAD_SECONDS=1800   ## fire pre-end update-all this long before ends_at
## Activity-tiered freshness rotation: only participants whose event-relevant
## metrics are moving stay on the fast roster-scaled cadence (active_count *
## SECONDS_PER_PLAYER, clamped to MIN/MAX); idle participants back off
## exponentially from IDLE_BASE to IDLE_MAX (~1 update/day when firmly idle).
## WOM asked us (2026-07) to stop mass-updating players daily — keep the
## per-cycle cap low: 5/cycle bounds the worst case near 1.4k calls/day.
# WOM_EVENT_UPDATE_SECONDS_PER_PLAYER=60
# WOM_EVENT_UPDATE_MIN_INTERVAL=1800   ## active-cohort floor: 30 min
# WOM_EVENT_UPDATE_MAX_INTERVAL=10800  ## active-cohort ceiling: 3 h
# WOM_EVENT_UPDATE_MAX_PER_CYCLE=5     ## hard cap on forced updates per reconcile cycle
# WOM_EVENT_IDLE_BASE_INTERVAL=3600    ## first idle backoff step (doubles each step)
# WOM_EVENT_IDLE_MAX_INTERVAL=86400    ## idle backoff ceiling: 24 h
GITHUB_TOKEN=0

## Used for encrypting webhooks
ENCRYPTION_KEY= ## -- Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" --

## Discord vars
## Real bot:
BOT_TOKEN= ## Insert bot token ##
# Dev bot token:
DEV_TOKEN= 
HALL_OF_FAME_BOT_TOKEN= ## -- Not included in git repository currently --
WEBHOOK_TOKEN= ## -- Processes non-API submissions; does not work properly on non-prod instances without changing client code --

DEV_WEBHOOK_TOKEN= ## -- ##

HEARTBEAT_BOT_TOKEN= ## -- ##

TEST_BOT_TOKEN= ## -- ##
DISCORD_BOT_CLIENT_ID= ## -- Your discord Client ID here -- ##
DISCORD_BOT_CLIENT_SECRET= ## -- Your discord client secret here -- ##
DISCORD_REDIRECT_URI="http://localhost:8080/auth/callback"
## Render "Open in Discord" launch buttons on event messages (deep-link into the
## Discord Activity). Keep OFF until the primary app has Activities enabled + a
## root URL mapping — a launch button errors otherwise. Off => website URL button.
ACTIVITY_DEEPLINK_ENABLED=false

PATREON_ACCESS_TOKEN= ## -- For reading patreon subscriptions / to-be-deprecated... --
LOGGER_TOKEN= ## -- for logging from other locations; no longer used currently

## Added to the footer of all embeds sent by the bot, usually:
DISCORD_MESSAGE_FOOTER="Powered by the DropTracker | https://www.droptracker.io/"

## Channel where new supporter contributions (subscription payments) are announced:
DISCORD_CONTRIBUTION_CHANNEL_ID=1490419196012793866

QUEUE_LENGTH=15 ## Defines how many drops should be stored in memory before attempting to append them to the database.

XF_KEY = ## -- For use on the live production instance to integrate with the back-end XenForo instance) -- 

## Cloudflare - used to ensure that if our IP changes (although it is static, 
# it very infrequently does change), our DNS records are updated quickly
CLOUDFLARE_API_TOKEN= ## -- ##
CLOUDFLARE_ZONE_ID= ## -- ##
CLOUDFLARE_RECORD_NAMES= ## -- ##

LOGGER_TOKEN= ## -- Used to auth the LoggerClient appropriately (not sure why i initially added this not gonna lie)


## Backblaze B2 Cloud Storage (for videos)
B2_KEY_ID= ## -- Your Backblaze B2 key ID --
B2_APPLICATION_KEY= ## -- Your Backblaze B2 application key --
B2_BUCKET_NAME=droptracker-video
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_CDN_BASE_URL=https://videos.droptracker.io

## Video processing settings
VIDEO_DAILY_LIMIT_FREE=5
VIDEO_DAILY_LIMIT_PREMIUM=50

DEBUG=True
DEBUG_LEVEL=false

## Webhook queue mode (Phase 1 async architecture)
## Set to true to enable fast-accept + background processing via workers/webhook_consumer.py
WEBHOOK_QUEUE_MODE=false
## Must be a path visible to BOTH the API and the consumer — the systemd units
## run with PrivateTmp=true, so /tmp is per-service and will NOT work.
WEBHOOK_TEMP_DIR=/store/droptracker/disc/data/webhook_uploads

## Shared secret for POST /manual-submit (intake API). The endpoint substitutes
## the target player's real account_hash, so it must never be publicly callable.
## Read by both droptracker-api (the gate) and droptracker-webapi (the caller).
## Unset/blank => the endpoint is disabled (returns 503). Use a long random value.
MANUAL_SUBMIT_KEY=

## Error tracking (optional). When set, every service inits Sentry at startup
## (utils/sentry.py). Unset => a logged no-op; nothing breaks if the package or
## DSN is missing.
SENTRY_DSN=

## ---------------------------------------------------------------
## Website API (web_api/, port 31325, systemd droptracker-webapi)
## ---------------------------------------------------------------
WEB_API_HOST=127.0.0.1
WEB_API_PORT=31325
JWT_TOKEN_KEY= ## -- HS256 signing key for web session JWTs (falls back to ENCRYPTION_KEY if unset) --
APP_SECRET_KEY= ## -- Quart session secret (bots/main.py legacy web session) --
# WEB_API_SESSION_TTL=604800        ## web session lifetime, seconds (default 7 days)
# WEB_API_GUILDS_CACHE_TTL=         ## Discord guild-role cache TTL (defaults to session TTL)
# WEB_API_CORS_ORIGINS=             ## comma-separated origins; empty = no CORS (BFF calls are server-to-server)
WEB_SUPERADMIN_DISCORD_IDS= ## -- comma-separated Discord IDs granted superadmin on login --
SITE_URL=http://localhost:3000 ## -- public site URL, used for billing redirects --

## Subscriptions / billing (web_api)
PAYPAL_RECEIVER_EMAIL= ## -- PayPal business email; IPNs to other receivers are rejected --
# PAYPAL_IPN_ALLOW_SANDBOX=false
STRIPE_SECRET_KEY= ## -- optional; Stripe checkout --
STRIPE_WEBHOOK_SECRET= ## -- optional; verifies Stripe webhook signatures --

## Misc integrations
DISCORD_TOKEN= ## -- used by services/message_handler.py --
DISCORD_GUILD_ID= ## -- primary guild for the webhook bot --
BAD_WORDS_API_URL= ## -- profanity check for player-facing names (utils/name_censor.py) --
BAD_WORDS_API_KEY=
# BAD_WORDS_API_TIMEOUT=5

## Suggestions & bug reports (web /suggestions page -> Discord forum posts)
SUGGESTIONS_FORUM_CHANNEL_ID= ## -- forum channel for 'suggestion' posts --
BUGS_FORUM_CHANNEL_ID= ## -- forum channel for 'bug' posts --
# WEB_SUGGESTIONS_PER_10MIN=5       ## per-user submission rate limit

## --- Knowledgebase + owner-only admin bot (kb01a, added 2026-07-24) ---
## Token for the NEW owner-only admin/KB bot (separate Discord application).
ADMIN_BOT_TOKEN=
## Guild(s) where the admin bot registers slash commands (comma-separated ids).
ADMIN_BOT_GUILD_IDS=1172737525069135962
## Extra Discord IDs allowed to operate the admin bot (bot-only; NOT web superadmin). Comma-separated.
ADMIN_BOT_OPERATOR_IDS=
## Public/general channels to mine into the KB (comma-separated channel ids).
KB_CHAT_CHANNEL_IDS=
## Local semantic embeddings (on|off). off = keyword-only FULLTEXT retrieval.
KB_EMBEDDINGS=on
KB_EMBED_MODEL=BAAI/bge-small-en-v1.5
KB_EMBED_CACHE=/store/droptracker/disc/.fastembed_cache
## Claude Code CLI used for KB answer synthesis (subscription auth, no API key).
CLAUDE_CLI_PATH=/home/debian/.local/bin/claude
KB_CLAUDE_MODEL=sonnet
KB_CLAUDE_TIMEOUT=180
## Raw SQL surface for the admin bot (/sql). Keep false until trust is earned.
KB_ALLOW_SQL=false
