# Hourly trigger for droptracker-prior-owned-pets.service.
#
# Install:  sudo cp deploy/systemd/droptracker-prior-owned-pets.{service,timer} /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now droptracker-prior-owned-pets.timer

[Unit]
Description=Hourly DropTracker previously-owned pet points sweep

[Timer]
OnCalendar=*-*-* *:17:00
RandomizedDelaySec=300
Persistent=true
Unit=droptracker-prior-owned-pets.service

[Install]
WantedBy=timers.target
