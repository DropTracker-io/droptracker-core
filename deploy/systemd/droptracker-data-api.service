[Unit]
Description=DropTracker Data API v2 (external, port 31326)
After=network.target

[Service]
Environment=PYTHONUNBUFFERED=1
User=debian
WorkingDirectory=/store/droptracker/disc
ExecStart=/store/droptracker/disc/venv/bin/python -u /store/droptracker/disc/venv/bin/hypercorn --workers 2 --worker-class asyncio --keep-alive 5 --graceful-timeout 10 --bind 127.0.0.1:31326 "data_api:create_app()"
Restart=always
RestartSec=5
TimeoutStopSec=30
Type=simple
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/store/droptracker
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
