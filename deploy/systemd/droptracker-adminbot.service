[Unit]
Description=DropTracker Admin/KB Bot (owner-only)
After=network.target

[Service]
# Runs as `debian` (NOT `user` like the other units): the KB answerer shells
# out to the Claude Code CLI, whose subscription auth state lives in
# /home/debian/.claude — so no ProtectHome/ProtectSystem hardening here.
User=debian
WorkingDirectory=/store/droptracker/disc
Environment=HOME=/home/debian
Environment=PATH=/home/debian/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/store/droptracker/disc/venv/bin/python -u -m bots.adminbot
Restart=on-failure
RestartSec=5
# adminbot exits 78 (EX_CONFIG) when ADMIN_BOT_TOKEN is unset — don't crash-loop on that.
RestartPreventExitStatus=78
TimeoutStopSec=30

# Systemd watchdog configuration
Type=notify
NotifyAccess=all
WatchdogSec=30
Environment=WATCHDOG_USEC=30000000

NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
