# Daily trigger for droptracker-site-icons.service at ~05:10 UTC.
#
# After droptracker-prune-images.timer (04:00) and well before the DB backup
# (08:30), so a slow sweep cannot land on either. Daily rather than hourly
# because the ingest hook already covers new gear in real time, and the clog
# catalogue only changes when the game does.
#
# Install:  sudo cp deploy/systemd/droptracker-site-icons.{service,timer} /etc/systemd/system/
#           sudo systemctl daemon-reload
#           sudo systemctl enable --now droptracker-site-icons.timer

[Unit]
Description=Daily DropTracker site item-icon sweep (~05:10 UTC)

[Timer]
OnCalendar=*-*-* 05:10:00 UTC
RandomizedDelaySec=900
Persistent=true
Unit=droptracker-site-icons.service

[Install]
WantedBy=timers.target
