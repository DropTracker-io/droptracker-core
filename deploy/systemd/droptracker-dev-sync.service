[Unit]
Description=DropTracker Dev Sync (pushes the Bug Tester roster to the dev instance)
Documentation=file:///store/droptracker/disc/workers/dev_sync.py
After=network.target redis-server.service mariadb.service

[Service]
Environment=PYTHONUNBUFFERED=1
User=user
WorkingDirectory=/store/droptracker/disc
ExecStart=/store/droptracker/disc/venv/bin/python -u -m workers.dev_sync
# always, not on-failure: the worker idles (and exits 0 on some paths) when it
# is not configured, and a clean exit must never leave the unit down.
Restart=always
RestartSec=5
TimeoutStopSec=30
Type=simple
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/store/droptracker
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
