# Safety net for item icons referenced only by stored PB gear loadouts.
# Triggered by droptracker-gear-icons.timer — do not enable the service itself.
#
# The primary mechanism is the ingest hook: data/submissions/pb._store_loadout
# hands its item ids to utils.item_images.ensure_item_images as loadouts
# arrive. This sweep exists because that hook can only ever cover what it saw —
# it does not recover ids stored before it existed, ids whose download failed
# transiently, or ids missed while the icon directory was unwritable (which is
# how the gap went unnoticed the first time: every caller treats a missing icon
# as a soft failure, so nothing ever complained).
#
# Cheap by construction: it reads only personal_best_loadouts (a few thousand
# short rows, never the drops table) and does one stat() per referenced id.
# With nothing missing it makes no network calls at all.
#
# Runs as `user` so a failure here proves the icon directory is still writable
# by the account the bots run as — which is the condition that actually broke.
#
# Manual dry run:  cd /store/droptracker/disc && venv/bin/python -m scripts.sweep_gear_item_images
# Manual real run: sudo systemctl start droptracker-gear-icons.service
# Watch it:        journalctl -u droptracker-gear-icons.service -f

[Unit]
Description=DropTracker gear item-icon sweep (backfill icons referenced by PB loadouts)
Wants=network-online.target
After=network-online.target mariadb.service mysql.service

[Service]
Type=oneshot
User=user
WorkingDirectory=/store/droptracker/disc
EnvironmentFile=/store/droptracker/disc/.env
ExecStart=/store/droptracker/disc/venv/bin/python -m scripts.sweep_gear_item_images --apply
TimeoutStartSec=30m
# Decorative cache warming; never urgent.
Nice=15
IOSchedulingClass=idle
